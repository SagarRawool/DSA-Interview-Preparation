
public class Main
{
	public static void main(String[] args) {
	//	System.out.println("Hello World");
		int[] height = {1,8,6,2,5,4,8,3,7};
		int max_water=0;
		int water_content;
		for (int i = 0; i<=height.length; i++)
		{
		    for (int j = i+1; j<=height.length-1; j++)
		    {
		        	//System.out.println("index of i is "+height[i]+" and index of j is "+height[j]);;
		        	int small_container;
		        	if(height[i]>height[j])
		        	{
		        	    small_container = height[j];
		        	}
		        	else{
		        	     small_container = height[i]; 
		        	}
		        	  System.out.println("Smallest container is "+small_container);
		        	  int container_distance = j-i;
		        	  System.out.println("Distance between two containers is "+container_distance);
		        	    
		        	    water_content=container_distance*small_container;
		        	    System.out.println("Water content calculated is "+ water_content);
		        	    
		        	    //max_water=water_content;
		        	    
		        	    if(max_water<water_content)
		        	    {
		        	       max_water=water_content; 
		        	    }
		    }
		}
		System.out.println("Maximum water which can be store is"+max_water);
	}
}
