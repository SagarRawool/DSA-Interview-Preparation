public class Main
{
	public static void main(String[] args) {
		int arr[] = {2, 3, 4, 7, 11, 15};
		int target=10;
		int sum;
		boolean found = false;
		outer: //label
		for(int i=0; i<arr.length-1; i++)
		{
		    for(int j=i+1; j<arr.length; j++)
		    {
		        sum = arr[i]+arr[j];
		        if(sum==target)
		        {
		            System.out.println("Two numbers are "+arr[i]+" and "+arr[j]);
		            found=true; 
		            break outer;
		        }
		    }
		    
		}
		if(found==false)
		    {
		        System.out.println("Pair not found");
		    }
	}
}
